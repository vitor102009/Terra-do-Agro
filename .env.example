# Copie este arquivo para .env e ajuste os valores.
# Nunca publique o arquivo .env.

# Ambiente: development ou production
FLASK_ENV_MODE=development

# Chave secreta. Em produção é obrigatória. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Em desenvolvimento, se ficar vazia, uma chave é gerada e salva em instance/secret_key.
SECRET_KEY=

# Banco de dados (padrão: SQLite em instance/terradoagro.db)
# DATABASE_URL=sqlite:///C:/caminho/para/terradoagro.db

# Ative quando o site estiver atrás de HTTPS (cookies seguros)
SESSION_COOKIE_SECURE=false

# Envio de e-mail (recuperação de senha e verificação de e-mail).
# Sem MAIL_SERVER, os e-mails são gravados em instance/mail_outbox/ (somente desenvolvimento).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Terra do Agro <nao-responda@exemplo.com.br>

# Clima via Open-Meteo (gratuito, sem chave). Defina false para desativar.
WEATHER_ENABLED=true

# Endereço público usado nos links enviados por e-mail
APP_BASE_URL=http://127.0.0.1:5000

# E-mail exibido como contato de suporte (opcional)
SUPPORT_EMAIL=
